# Переменные окружения сервисов. Файл читают:
# - docker compose (подстановка ${...} в docker-compose.yaml и env_file);
# - docker container run --env-file .env (этап 2);
# - fix_datasource_uid.py (логин и пароль Grafana).
# Значения пишем без кавычек и без комментариев в той же строке:
# docker run --env-file передаёт их в контейнер как есть.

# --- FastAPI-микросервис (внутри контейнера) ---
# модель и метаданные, путь от рабочей директории /app
MODEL_PATH=models/price_model.pkl
MODEL_META_PATH=models/model_meta.json
# уровень логов uvicorn: debug, info, warning, error
LOG_LEVEL=info

# --- порты на хосте: если порт занят другим сервисом, достаточно поменять его здесь ---
APP_PORT=8081
PROMETHEUS_PORT=9090
# fix_datasource_uid.py обращается к Grafana на порту 3000
GRAFANA_PORT=3000

# эти переменные для Grafana должны называться именно так
GRAFANA_USER=admin
GRAFANA_PASS=mle_sprint3
